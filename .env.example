# Copia este archivo como .env.local. Nunca subas .env.local al repositorio.
# Con estos valores vacíos, la app usa el navegador y no exige una cuenta.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Necesario junto a las dos variables de Turso para habilitar cuentas.
# Genera un secreto de al menos 32 caracteres con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Opcional: origen HTTPS exacto de Vercel, sin una ruta final.
# Si queda vacío, se toma el origen del despliegue.
APP_ORIGIN=

# Puerto para npm run dev. No cambia el puerto de Vercel.
PORT=4173
